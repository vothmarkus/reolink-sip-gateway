#!/usr/bin/with-contenv bashio
set -euo pipefail

# v0.7.0 retains the grouped Home Assistant configuration and adds an opt-in
# incoming-call switch to the Call group.
# The Go gateway still receives the same flat runtime configuration used by
# v0.5.7-v0.5.9. Grouped UI values are flattened immediately before exec.
#
# A persistent marker separates the one-time legacy migration from normal
# operation. Before the marker exists, legacy flat 0.5.x keys take precedence
# over Supervisor-materialized grouped defaults. After migration, grouped keys
# are authoritative and normal starts never write options back to Supervisor.
#
# Public NVR channels remain 1-based. The private runtime keeps the legacy
# protocol representation:
#   nvr_channel         = UI channel - 1
#   reolink_stream_path = /Preview_NN_sub (or Preview_01_sub for standalone)
#
# The retired AEC search-window option is no longer public. A fixed internal
# compatibility value of 300 ms is injected because the unchanged Go config
# struct still validates that legacy field; live Go delay tracking is disabled.

OPTIONS_FILE="${OPTIONS_FILE:-/data/options.json}"
GROUPED_OPTIONS_MARKER="${GROUPED_OPTIONS_MARKER:-/data/.reolink-sip-gateway-grouped-options-v1}"

supervisor_options_write() {
    local options=${1}

    if declare -F bashio::app.options >/dev/null 2>&1; then
        bashio::app.options self "${options}"
        return $?
    fi
    if declare -F bashio::addon.options >/dev/null 2>&1; then
        bashio::addon.options self "${options}"
        return $?
    fi

    bashio::log.warning "Neither bashio::app.options nor bashio::addon.options is available; skipping option migration"
    return 1
}

load_public_options() {
    cat "${OPTIONS_FILE}"
}

normalize_public_options() {
    local options=${1}
    local prefer_legacy=${2:-false}

    # Before the migration marker exists, old flat values must beat newly
    # materialized grouped defaults. Once migration is confirmed, the grouped
    # representation is authoritative; flat keys are only a last-resort
    # compatibility fallback and can no longer overwrite user edits.
    jq -c --argjson prefer_legacy "${prefer_legacy}" '
        def current($group; $key; $default):
            if $prefer_legacy and has($key) then .[$key]
            elif ((.[$group] // {}) | has($key)) then .[$group][$key]
            elif has($key) then .[$key]
            else $default
            end;

        def current_mode:
            if $prefer_legacy and has("reolink_mode") then .reolink_mode
            elif $prefer_legacy and has("connection_mode") then .connection_mode
            elif ((.reolink // {}) | has("reolink_mode")) then .reolink.reolink_mode
            elif has("reolink_mode") then .reolink_mode
            elif has("connection_mode") then .connection_mode
            else "auto"
            end;

        def current_channel:
            if $prefer_legacy and has("nvr_channel_number") then .nvr_channel_number
            elif $prefer_legacy and has("nvr_channel") then (.nvr_channel + 1)
            elif $prefer_legacy and has("baichuan_channel") then (.baichuan_channel + 1)
            elif ((.reolink // {}) | has("nvr_channel_number")) then .reolink.nvr_channel_number
            elif has("nvr_channel_number") then .nvr_channel_number
            elif has("nvr_channel") then (.nvr_channel + 1)
            elif has("baichuan_channel") then (.baichuan_channel + 1)
            else 1
            end;

        {
          reolink: {
            reolink_host: current("reolink"; "reolink_host"; "192.168.177.50"),
            reolink_username: current("reolink"; "reolink_username"; "admin"),
            reolink_password: current("reolink"; "reolink_password"; ""),
            reolink_mode: current_mode,
            nvr_channel_number: current_channel,
            reolink_rtsp_port: current("reolink"; "reolink_rtsp_port"; 554),
            baichuan_port: current("reolink"; "baichuan_port"; 9000)
          },
          sip: {
            sip_registrar: current("sip"; "sip_registrar"; "auto"),
            sip_registrar_port: current("sip"; "sip_registrar_port"; 5060),
            sip_username: current("sip"; "sip_username"; ""),
            sip_password: current("sip"; "sip_password"; ""),
            sip_destination: current("sip"; "sip_destination"; "**610"),
            sip_local_port: current("sip"; "sip_local_port"; 5070),
            sip_display_name: current("sip"; "sip_display_name"; "Haustür"),
            sip_codec_preference: current("sip"; "sip_codec_preference"; "pcma")
          },
          audio: {
            echo_cancellation_enabled: current("audio"; "echo_cancellation_enabled"; true),
            webrtc_high_pass_filter_enabled: current("audio"; "webrtc_high_pass_filter_enabled"; true),
            webrtc_noise_suppression_enabled: current("audio"; "webrtc_noise_suppression_enabled"; true)
          },
          call: {
            visitor_entity: current("call"; "visitor_entity"; "auto"),
            incoming_calls_enabled: current("call"; "incoming_calls_enabled"; false),
            debounce_seconds: current("call"; "debounce_seconds"; 3),
            ring_timeout_seconds: current("call"; "ring_timeout_seconds"; 30),
            max_call_duration_seconds: current("call"; "max_call_duration_seconds"; 300)
          },
          diagnostics: {
            log_level: current("diagnostics"; "log_level"; "info"),
            dry_run: current("diagnostics"; "dry_run"; true)
          }
        }
    ' <<<"${options}"
}

detect_default_ipv4_gateway() {
    local route_file="${IPV4_ROUTE_FILE:-/proc/net/route}"
    local iface destination gateway flags refcnt use metric mask mtu window irtt header
    local flags_dec metric_dec best_metric='' best_gateway='' hex

    [[ -r "${route_file}" ]] || return 1

    # /proc/net/route stores IPv4 addresses as little-endian hexadecimal.
    # Select the usable default route with the lowest metric and a real
    # gateway. This avoids depending on optional iproute2 tooling.
    {
        read -r header || return 1
        while read -r iface destination gateway flags refcnt use metric mask mtu window irtt; do
            [[ "${destination}" == "00000000" ]] || continue
            [[ "${gateway}" =~ ^[0-9A-Fa-f]{8}$ ]] || continue
            [[ "${gateway}" != "00000000" ]] || continue
            [[ "${flags}" =~ ^[0-9A-Fa-f]+$ ]] || continue
            [[ "${metric}" =~ ^[0-9]+$ ]] || continue

            flags_dec=$((16#${flags}))
            # Require RTF_UP (0x1) and RTF_GATEWAY (0x2).
            (( (flags_dec & 0x3) == 0x3 )) || continue
            metric_dec=$((10#${metric}))

            if [[ -z "${best_metric}" ]] || (( metric_dec < best_metric )); then
                best_metric=${metric_dec}
                best_gateway=${gateway^^}
            fi
        done
    } < "${route_file}"

    [[ -n "${best_gateway}" ]] || return 1
    hex=${best_gateway}
    printf '%d.%d.%d.%d\n' \
        "$((16#${hex:6:2}))" \
        "$((16#${hex:4:2}))" \
        "$((16#${hex:2:2}))" \
        "$((16#${hex:0:2}))"
}


resolve_reolink_visitor_entity() {
    /usr/bin/reolink-sip-gateway -resolve-visitor-entity
}

build_runtime_options() {
    local options=${1}
    local ui_channel internal_channel mode stream_channel stream_path runtime
    local sip_registrar detected_gateway visitor_entity detected_visitor

    ui_channel="$(jq -r '.reolink.nvr_channel_number' <<<"${options}")"
    mode="$(jq -r '.reolink.reolink_mode' <<<"${options}")"
    sip_registrar="$(jq -r '.sip.sip_registrar' <<<"${options}")"
    visitor_entity="$(jq -r '.call.visitor_entity' <<<"${options}")"

    if [[ "${sip_registrar,,}" == "auto" ]]; then
        if ! detected_gateway="$(detect_default_ipv4_gateway)"; then
            bashio::log.error "SIP registrar is set to 'auto', but no IPv4 default gateway could be detected. Set SIP → SIP registrar to an IP address or DNS name."
            return 1
        fi
        sip_registrar=${detected_gateway}
        bashio::log.info "SIP registrar auto-detected from Home Assistant host IPv4 default gateway: ${sip_registrar}"
    fi

    if [[ "${visitor_entity,,}" == "auto" ]]; then
        if [[ -z "${SUPERVISOR_TOKEN:-}" ]]; then
            bashio::log.error "Visitor entity is set to 'auto', but SUPERVISOR_TOKEN is missing. Set Call → Reolink visitor sensor manually or enable homeassistant_api."
            return 1
        fi
        if ! detected_visitor="$(resolve_reolink_visitor_entity 2>&1)"; then
            bashio::log.error "Visitor entity auto-detection failed: ${detected_visitor}"
            return 1
        fi
        visitor_entity=${detected_visitor}
        bashio::log.info "Home Assistant Reolink visitor entity auto-detected: ${visitor_entity}"
    fi

    if [[ ! "${ui_channel}" =~ ^[0-9]+$ ]] || (( ui_channel < 1 || ui_channel > 256 )); then
        ui_channel=1
    fi

    # Preserve the exact proven 0.5.1/0.5.7 runtime channel semantics.
    if [[ "${mode}" == "standalone" ]]; then
        internal_channel=0
        stream_channel=1
    else
        internal_channel=$((ui_channel - 1))
        stream_channel=${ui_channel}
    fi
    printf -v stream_path '/Preview_%02d_sub' "${stream_channel}"

    runtime="$(jq -c \
        --argjson channel "${internal_channel}" \
        --arg path "${stream_path}" \
        --arg sip_registrar "${sip_registrar}" \
        --arg visitor_entity "${visitor_entity}" \
        '
          (.reolink + .sip + .audio + .call + .diagnostics)
          | del(.nvr_channel_number)
          | .nvr_channel = $channel
          | .reolink_stream_path = $path
          | .sip_registrar = $sip_registrar
          | .visitor_entity = $visitor_entity
          | .echo_cancellation_search_window_ms = 300
        ' <<<"${options}")"

    printf '%s\n' "${runtime}" > /tmp/reolink-sip-gateway-runtime-options.json
}

complete_grouping_migration() {
    local original=${1}
    local normalized=${2}
    local original_canonical normalized_canonical current current_canonical

    # A marker means migration already completed successfully (or the current
    # configuration was already purely grouped). Normal starts are read-only.
    if [[ -e "${GROUPED_OPTIONS_MARKER}" ]]; then
        return 0
    fi

    original_canonical="$(jq -cS . <<<"${original}")"
    normalized_canonical="$(jq -cS . <<<"${normalized}")"

    # 0.5.8/0.5.9 users may already have a clean grouped layout. Confirm that
    # state without writing anything to Supervisor.
    if [[ "${original_canonical}" == "${normalized_canonical}" ]]; then
        : > "${GROUPED_OPTIONS_MARKER}"
        bashio::log.info "Reolink SIP Gateway v0.7.0 grouped option layout confirmed"
        return 0
    fi

    # Never persist a stale migration snapshot over a user edit. Re-read the
    # Supervisor-mounted options immediately before the one-time write and
    # require an exact canonical match with the snapshot normalized above.
    current="$(load_public_options)"
    current_canonical="$(jq -cS . <<<"${current}")"
    if [[ "${current_canonical}" != "${original_canonical}" ]]; then
        bashio::log.warning "App options changed while the legacy grouping migration was being prepared; skipping stale persistence"
        return 0
    fi

    if supervisor_options_write "${normalized}"; then
        : > "${GROUPED_OPTIONS_MARKER}"
        bashio::log.info "Reolink SIP Gateway v0.7.0 one-time option grouping migration completed"
    else
        bashio::log.warning "Could not persist grouped options; runtime translation remains active and migration will be retried on the next start"
    fi
}

PUBLIC_OPTIONS="$(load_public_options)"
if [[ -e "${GROUPED_OPTIONS_MARKER}" ]]; then
    PREFER_LEGACY=false
else
    PREFER_LEGACY=true
fi
NORMALIZED_OPTIONS="$(normalize_public_options "${PUBLIC_OPTIONS}" "${PREFER_LEGACY}")"
build_runtime_options "${NORMALIZED_OPTIONS}"
complete_grouping_migration "${PUBLIC_OPTIONS}" "${NORMALIZED_OPTIONS}"
exec /usr/bin/reolink-sip-gateway -config /tmp/reolink-sip-gateway-runtime-options.json
