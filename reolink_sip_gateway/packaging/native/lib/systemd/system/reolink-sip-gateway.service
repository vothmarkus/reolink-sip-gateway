[Unit]
Description=Reolink SIP Gateway
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=reolink-sip-gateway
Group=reolink-sip-gateway
WorkingDirectory=/var/lib/reolink-sip-gateway
ExecStart=/usr/bin/reolink-sip-gateway -mode standalone -data-dir /var/lib/reolink-sip-gateway
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/reolink-sip-gateway

[Install]
WantedBy=multi-user.target
